PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── PostgreSQL Database (Local PostgreSQL 18 on Port 4000) ───
# If you set a password in pgAdmin, put it in DB_PASSWORD below:
DB_HOST=localhost
DB_PORT=4000
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cineverse

# Or full URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:4000/cineverse

# ─── JWT Authentication ───
JWT_SECRET=cineverse_jwt_ultra_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Stripe (optional: leave empty or mock for simulated payments) ───
STRIPE_SECRET_KEY=sk_test_mock_cineverse
STRIPE_PUBLISHABLE_KEY=pk_test_mock_cineverse
STRIPE_WEBHOOK_SECRET=whsec_mock

# ─── Email (Nodemailer - optional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CineVerse" <tickets@cineverse.com>
